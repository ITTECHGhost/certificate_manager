# .gitignore

# SQLite databases
*.db
*.sqlite3

# Python cache and environments
__pycache__/
*.py[cod]
*$py.class
venv/
env/
.venv/

# Raw SQL dumps (prevents uploading sensitive student data to GitHub)
# *.sql

# OS generated files
.DS_Store
Thumbs.db

# VS Code settings
.vscode/
# Secrets: never commit
certificate_manager_api/app_keys.json
certificate_manager_api/certs/
*.key
server_config.json

# Runtime files
logs/
.nicegui/
*.db-shm
*.db-wal
certificate_manager_api/client_package/
