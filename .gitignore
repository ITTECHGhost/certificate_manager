# .gitignore

# SQLite databases
*.db
*.sqlite3

# Python cache and environments
__pycache__/
*.py[cod]
*$py.class
venv/
env/
.venv/

# Raw SQL dumps (prevents uploading sensitive student data to GitHub)
# *.sql

# OS generated files
.DS_Store
Thumbs.db

# VS Code settings
.vscode/
# Secrets: never commit
certificate_manager_api/app_keys.json
certificate_manager_api/certs/
*.key
server_config.json

# Runtime files
logs/
.nicegui/
*.db-shm
*.db-wal
certificate_manager_api/client_package/
certificate_manager_api/server_settings.json
certificate_manager_api/_backup_before_update/
certificate_manager_api/logs/

# Tests (golden files hold real student data: never commit them)
tests/.golden/
.pytest_cache/

# Generated documents, local data dumps and build output
certificates/
sql/SQLite.sql
dist/
build/

# Archived files that hold data or passwords (kept on disk, never in git)
old/sql_dumps/
old/root_duplicates/

# Per-install secrets (server and client)
certificate_manager_api/db_config.json
.storage_secret

# Third-party installers for the server bundle (AppServ, Python); too large for git
installer/server/prereqs/*
!installer/server/prereqs/README.txt
